{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "MinGW GCC",
      "description": "Native MinGW-w64 GCC toolchain for EnergySavior",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ]
}
